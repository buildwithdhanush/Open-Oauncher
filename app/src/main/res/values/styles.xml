<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.OpenDeck" parent="Theme.Material.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">@color/black</item>
        <!-- Window background. -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Text color. -->
        <item name="android:textColorPrimary">@color/black</item>
        <!-- Contextual action mode background. -->
        <item name="colorContextActionModeBackground">@color/white</item>
        <item name="colorContextActionModeDivider">@color/black</item>
        <item name="colorContextActionModePalette">@color/primary_dark</item>
    </style>

    <!-- NoActionBar theme used for onboarding -->
    <style name="Theme.OpenDeck.NoActionBar" parent="Theme.OpenDeck">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- General theme -->
    <style name="Theme.OpenDeck.Settings" parent="Theme.OpenDeck"/>

    <!-- Item editor theme -->
    <style name="Theme.OpenDeck.ItemEditor" parent="Theme.OpenDeck"/>

    <!-- Folder editor theme -->
    <style name="Theme.OpenDeck.FolderEditor" parent="Theme.OpenDeck"/>

</resources>